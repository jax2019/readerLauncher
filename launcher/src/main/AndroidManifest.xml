<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <package android:name="com.ireaderlauncher.powerbridge" />
        <package android:name="com.android.settings" />
        <package android:name="com.szzy.ireader.settings" />
        <package android:name="com.zhangyue.iReader.Eink" />
        <package android:name="com.szzy.ireader.ink.ai" />
        <package android:name="com.szzy.ireader.ink.launcher" />
        <package android:name="com.szzy.ireader.ink.wifidirect" />
        <package android:name="com.szzy.ireader.ink.office.reflow" />
        <package android:name="com.android.printspooler" />
    </queries>
    <application android:label="阅桌面" android:icon="@drawable/ic_launcher" android:theme="@style/AppTheme"
        android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PowerActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".AppsActivity" android:exported="false" />
    </application>
</manifest>
